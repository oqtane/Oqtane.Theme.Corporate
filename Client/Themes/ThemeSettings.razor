                    <input id="default-color" type="text" class="form-control" placeholder="#000000" @bind="@_defaultColor" />
                    <input id="default-color" type="color" @bind="@_defaultColor" style="width: 40px; height: 40px;" />
                    @if (_defaultColor == defaultColor)
                    {
                        <button type="button" class="btn btn-secondary" disabled>Reset</button>
