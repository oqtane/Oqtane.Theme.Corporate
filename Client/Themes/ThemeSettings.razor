</Section>
<Section Name="DarkSectionColors" Heading="Dark Section Colors" ResourceKey="DarkSectionColors" Expanded="False">
    <div class="container">
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="dark-background-background-color" HelpText="Optionally specify a background color for dark sections">Background Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="dark-background-background-color" class="form-control" placeholder="#000000" @bind="@_darkBackgroundBackgroundColor" />
