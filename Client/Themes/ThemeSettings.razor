@namespace Oqtane.Theme.Corporate
@using Oqtane.Theme.Corporate.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@using System.Text.Json
@inherits ModuleBase
@implements Oqtane.Interfaces.ISettingsControl
@inject ISettingService SettingService
@inject ICorporateThemeService CorporateThemeService
@inject IStringLocalizer<Default> Localizer
@attribute [OqtaneIgnore]

<div class="container">
    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="login" HelpText="Specify if a Login option should be displayed. Note that this option does not prevent the login page from being accessible via a direct url.">Show Login?</Label>
        <div class="col-sm-9">
            <select id="login" class="form-select" @bind="@_login">
                <option value="True">Yes</option>
                <option value="False">No</option>
            </select>
        </div>
    </div>
    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="search" HelpText="Specify if a search icon should be displayed">Show Search?</Label>
        <div class="col-sm-9">
            <select id="search" class="form-select" @bind="@_search">
                <option value="True">Yes</option>
                <option value="False">No</option>
            </select>
        </div>
    </div>
    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="_navbutton" HelpText="Specify if you wish to include a call-to-action button in the navigation for this site">Navigation Button?</Label>
        <div class="col-sm-9">
            <select id="navbutton" class="form-select" @bind="@_navbutton">
                <option value="True">Yes</option>
                <option value="False">No</option>
            </select>
            @if (_navbutton == "True")
            {
                <input id="navbuttoncode" class="form-control" placeholder="Button Text" @bind="@_navbuttontext" />
                <input id="navbuttonurl" class="form-control" placeholder="Button Url" @bind="@_navbuttonurl" />
            }
        </div>
    </div>
</div>
<Section Name="Hero" Heading="Hero Banner" ResourceKey="Hero" Expanded="False">
    <div class="container">
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="heroHTML" HelpText="Specify if you wish to include a hero banner for this page">Include Banner?</Label>
            <div class="col-sm-9">
                <select id="heroHTML" class="form-select" value="@_hero" @onchange="(e => HeroChanged(e))">
                    <option value="True">Yes</option>
                    <option value="False">No</option>
                </select>
                @if (_hero == "True")
                {
                    <textarea id="_heroHTML" class="form-control" @bind="@_heroHTML" rows="5"></textarea>
                }
            </div>
        </div>
    </div>
</Section>
<Section Name="Footer" Heading="Footer Section" ResourceKey="Footer" Expanded="False">
    <div class="container">
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="_footerHTML" HelpText="Specify if you wish to include a footer section for this site">Include Footer?</Label>
            <div class="col-sm-9">
                <select id="footerHTML" class="form-select" value="@_footer" @onchange="(e => FooterChanged(e))">
                    <option value="True">Yes</option>
                    <option value="False">No</option>
                </select>
                @if (_footer == "True")
                {
                    <textarea id="footerHTML" class="form-control" @bind="@_footerHTML" rows="5"></textarea>
                }
            </div>
        </div>
    </div>
</Section>
<Section Name="MainColors" Heading="Main Colors" ResourceKey="Colors" Expanded="False">
    <div class="container">
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="background-color" HelpText="Optionally specify a background color for the entire website, including individual sections">Background Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="background-color" type="text" class="form-control" placeholder="#000000" @bind="@_backgroundColor" />
                    <input id="background-color" type="color" @bind="@_backgroundColor" style="width: 40px; height: 40px;" />
                    @if (_backgroundColor == backgroundColor)
                    {
                        <button type="button" class="btn btn-secondary" disabled>Reset</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" @onclick="@(() => ResetColor("backgroundColor"))">Reset</button>
                    }
                </div>
            </div>
        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="default-color" HelpText="Optionally specify a default color used for the majority of the text content across the entire website">Default Color:</Label>
