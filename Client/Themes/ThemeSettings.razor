        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="dark-background-surface-color" HelpText="Optionally specify a surface color for dark sections">Surface Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="dark-background-surface-color" class="form-control" placeholder="#000000" @bind="@_darkBackgroundSurfaceColor" />
                    <button type="button" class="btn btn-secondary" @onclick="@StateHasChanged">Show</button>
                    <div style="background-color: @_darkBackgroundSurfaceColor; width: 50px">&nbsp;</div>
                </div>
            </div>
        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="dark-background-default-color" HelpText="Optionally specify a default color for dark sections">Default Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="dark-background-default-color" class="form-control" placeholder="#000000" @bind="@_darkBackgroundDefaultColor" />
                    <button type="button" class="btn btn-secondary" @onclick="@StateHasChanged">Show</button>
                    <div style="background-color: @_darkBackgroundDefaultColor; width: 50px">&nbsp;</div>
                </div>
            </div>
        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="dark-background-heading-color" HelpText="Optionally specify a heading color for dark sections">Heading Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="dark-background-heading-color" class="form-control" placeholder="#000000" @bind="@_darkBackgroundHeadingColor" />
