                        <button type="button" class="btn btn-secondary" disabled>Reset</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" @onclick="@(() => ResetColor("accentColor"))">Reset</button>
                    }
                </div>
            </div>
        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="surface-color" HelpText="Optionally specify a surface color is used as a background of boxed elements within sections, such as cards, icon boxes, or other elements that require a visual separation from the global background">Surface Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="surface-color" type="text" class="form-control" placeholder="#000000" @bind="@_surfaceColor" />
