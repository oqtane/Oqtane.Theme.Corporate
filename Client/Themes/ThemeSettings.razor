        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="dark-background-contrast-color" HelpText="Optionally specify a contrast color for dark sections">Contrast Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="dark-background-contrast-color" class="form-control" placeholder="#000000" @bind="@_darkBackgroundContrastColor" />
                    <button type="button" class="btn btn-secondary" @onclick="@StateHasChanged">Show</button>
                    <div style="background-color: @_darkBackgroundContrastColor; width: 50px">&nbsp;</div>
                </div>
            </div>
        </div>
    </div>
</Section>

@code {
    private int pageId = -1;
    private string _login = "True";
    private string _search = "True";
    private string _navbutton = "False";
    private string _navbuttontext = "";
    private string _navbuttonurl = "";
    private string _hero = "False";
    private string _heroHTML = "";
    private string _footer = "False";
    private string _footerHTML = "";

    private string _backgroundColor = "";
    private string _defaultColor = "";
    private string _headingColor = "";
    private string _accentColor = "";
    private string _surfaceColor = "";
    private string _contrastColor = "";
    private string _headerBackgroundColor = "";
    private string _headerHeadingColor = "";
    private string _navColor = "";
    private string _navHoverColor = "";
    private string _navMobileBackgroundColor = "";
    private string _navDropdownBackgroundColor = "";
    private string _navDropdownColor = "";
    private string _navDropdownHoverColor = "";
    private string _lightBackgroundBackgroundColor = "";
    private string _lightBackgroundSurfaceColor = "";
    private string _darkBackgroundBackgroundColor = "";
    private string _darkBackgroundSurfaceColor = "";
    private string _darkBackgroundDefaultColor = "";
    private string _darkBackgroundHeadingColor = "";
    private string _darkBackgroundContrastColor = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (PageState.QueryString.ContainsKey("id"))
            {
                pageId = int.Parse(PageState.QueryString["id"]);
            }
            await LoadSettings();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Settings {Error}", ex.Message);
            AddModuleMessage("Error Loading Settings", MessageType.Error);
        }
    }

    private async Task LoadSettings()
    {
        // page settings
        var settings = await SettingService.GetPageSettingsAsync(pageId);
        _heroHTML = SettingService.GetSetting(settings, GetType().Namespace + ":Hero", "");
        _hero = (_heroHTML == "") ? "False" : "True";

        // site settings
        settings = PageState.Site.Settings;
        _login = SettingService.GetSetting(settings, GetType().Namespace + ":Login", "True");
        _search = SettingService.GetSetting(settings, GetType().Namespace + ":Search", "True");
        _navbuttontext = SettingService.GetSetting(settings, GetType().Namespace + ":NavButtonText", "");
        _navbuttonurl = SettingService.GetSetting(settings, GetType().Namespace + ":NavButtonUrl", "");
        if (!string.IsNullOrEmpty(_navbuttontext) && !string.IsNullOrEmpty(_navbuttonurl))
        {
            _navbutton = "True";
        }
        _footerHTML = SettingService.GetSetting(settings, GetType().Namespace + ":Footer", "");
        _footer = (_footerHTML == "") ? "False" : "True";

        // colors
        _backgroundColor = SettingService.GetSetting(settings, GetType().Namespace + ":root:--background-color", "");
        _defaultColor = SettingService.GetSetting(settings, GetType().Namespace + ":root:--default-color", "");
        _headingColor = SettingService.GetSetting(settings, GetType().Namespace + ":root:--heading-color", "");
        _accentColor = SettingService.GetSetting(settings, GetType().Namespace + ":root:--accent-color", "");
        _surfaceColor = SettingService.GetSetting(settings, GetType().Namespace + ":root:--surface-color", "");
        _contrastColor = SettingService.GetSetting(settings, GetType().Namespace + ":root:--contrast-color", "");
        _headerBackgroundColor = SettingService.GetSetting(settings, GetType().Namespace + ":.header:--background-color", "");
        _headerHeadingColor = SettingService.GetSetting(settings, GetType().Namespace + ":.header:--heading-color", "");
        _navColor = SettingService.GetSetting(settings, GetType().Namespace + ":root:--nav-color", "");
        _navHoverColor = SettingService.GetSetting(settings, GetType().Namespace + ":root:--nav-hover-color", "");
        _navMobileBackgroundColor = SettingService.GetSetting(settings, GetType().Namespace + ":root:--nav-mobile-background-color", "");
        _navDropdownBackgroundColor = SettingService.GetSetting(settings, GetType().Namespace + ":root:--nav-dropdown-background-color", "");
        _navDropdownColor = SettingService.GetSetting(settings, GetType().Namespace + ":root:--nav-dropdown-color", "");
        _navDropdownHoverColor = SettingService.GetSetting(settings, GetType().Namespace + ":root:--nav-dropdown-hover-color", "");
        _lightBackgroundBackgroundColor = SettingService.GetSetting(settings, GetType().Namespace + ":.light-background:--background-color", "");
        _lightBackgroundSurfaceColor = SettingService.GetSetting(settings, GetType().Namespace + ":.light-background:--surface-color", "");
        _darkBackgroundBackgroundColor = SettingService.GetSetting(settings, GetType().Namespace + ":.dark-background:--background-color", "");
        _darkBackgroundSurfaceColor = SettingService.GetSetting(settings, GetType().Namespace + ":.dark-background:--surface-color", "");
        _darkBackgroundDefaultColor = SettingService.GetSetting(settings, GetType().Namespace + ":.dark-background:--default-color", "");
        _darkBackgroundHeadingColor = SettingService.GetSetting(settings, GetType().Namespace + ":.dark-background:--heading-color", "");
        _darkBackgroundContrastColor = SettingService.GetSetting(settings, GetType().Namespace + ":.dark-background:--contrast-color", "");
    }

    private void HeroChanged(ChangeEventArgs eventArgs)
    {
        _hero = (string)eventArgs.Value;
        if (bool.Parse(_hero))
        {
            if (_heroHTML == "")
            {
                _heroHTML = Localizer["Hero"];
            }
        }
        else
        {
            _heroHTML = "";
        }
    }

    private void FooterChanged(ChangeEventArgs eventArgs)
    {
        _footer = (string)eventArgs.Value;
        if (bool.Parse(_footer))
        {
            if (_footerHTML == "")
            {
                _footerHTML = Localizer["Footer"];
            }
        }
        else
        {
            _footerHTML = "";
        }
    }

    public async Task UpdateSettings()
    {
        try
        {
            // page settings
            var settings = await SettingService.GetPageSettingsAsync(pageId);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":Hero", _heroHTML);
            await SettingService.UpdatePageSettingsAsync(settings, pageId);

            // site settings
            settings = await SettingService.GetSiteSettingsAsync(PageState.Site.SiteId);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":Login", _login);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":Search", _search);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":NavButtonText", _navbuttontext);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":NavButtonUrl", _navbuttonurl);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":Footer", _footerHTML);

            // colors
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":root:--background-color", _backgroundColor);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":root:--default-color", _defaultColor);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":root:--heading-color", _headingColor);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":root:--accent-color", _accentColor);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":root:--surface-color", _surfaceColor);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":root:--contrast-color", _contrastColor);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":.header:--background-color", _headerBackgroundColor);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":.header:--heading-color", _headerHeadingColor);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":root:--nav-color", _navColor);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":root:--nav-hover-color", _navHoverColor);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":root:--nav-mobile-background-color", _navMobileBackgroundColor);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":root:--nav-dropdown-background-color", _navDropdownBackgroundColor);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":root:--nav-dropdown-color", _navDropdownColor);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":root:--nav-dropdown-hover-color", _navDropdownHoverColor);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":.light-background:--background-color", _lightBackgroundBackgroundColor);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":.light-background:--surface-color", _lightBackgroundSurfaceColor);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":.dark-background:--background-color", _darkBackgroundBackgroundColor);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":.dark-background:--surface-color", _darkBackgroundSurfaceColor);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":.dark-background:--default-color", _darkBackgroundDefaultColor);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":.dark-background:--heading-color", _darkBackgroundHeadingColor);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":.dark-background:--contrast-color", _darkBackgroundContrastColor);

            await SettingService.UpdateSiteSettingsAsync(settings, PageState.Site.SiteId);

            if (UserSecurity.IsAuthorized(PageState.User, RoleNames.Admin))
            {
                await CorporateThemeService.UpdateStylesheetAsync(ModuleState.SiteId);
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Saving Settings {Error}", ex.Message);
            AddModuleMessage("Error Saving Settings", MessageType.Error);
        }
    }
}
