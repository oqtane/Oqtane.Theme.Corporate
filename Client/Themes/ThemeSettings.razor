<Section Name="ImportExport" Heading="Import/Export" ResourceKey="ImportExport" Expanded="False">
    <div class="container">
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="export" HelpText="Export current theme colors">Export Colors:</Label>
            <div class="col-sm-9">
                <a class="btn btn-secondary" href="@GetExportUrl()" download="@_exportFileName">Export</a>
            </div>
        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="import" HelpText="Import theme colors">Import Colors:</Label>
            <div class="col-sm-9">
                <InputFile id="import" class="form-control" accept=".json,application/json" OnChange="ImportColorsAsync" />
            </div>
        </div>
    </div>
</Section>

@code {
    private int pageId = -1;
    private string _login = "True";
    private string _search = "True";
    private string _navbutton = "False";
    private string _navbuttontext = "";
    private string _navbuttonurl = "";
    private string _hero = "False";
    private string _heroHTML = "";
    private string _footer = "False";
    private string _footerHTML = "";

    // default theme colors
    private string backgroundColor = "#ffffff";
    private string defaultColor = "#444444";
    private string headingColor = "#37517e";
    private string accentColor = "#47b2e4";
    private string surfaceColor = "#ffffff";
    private string contrastColor = "#ffffff";
    private string headerBackgroundColor = "#3d4d6a";
    private string headerHeadingColor = "#ffffff";
    private string navColor = "#ffffff";
    private string navHoverColor = "#47b2e4";
    private string navMobileBackgroundColor = "#ffffff";
    private string navDropdownBackgroundColor = "#ffffff";
    private string navDropdownColor = "#444444";
    private string navDropdownHoverColor = "#47b2e4";
    private string lightBackgroundBackgroundColor = "#f5f6f8";
    private string lightBackgroundSurfaceColor = "#ffffff";
    private string darkBackgroundBackgroundColor = "#37517e";
    private string darkBackgroundSurfaceColor = "#ffffff";
    private string darkBackgroundDefaultColor = "#ffffff";
    private string darkBackgroundHeadingColor = "#4668a2";
    private string darkBackgroundContrastColor = "#ffffff";

    private string _backgroundColor = "";
    private string _defaultColor = "";
    private string _headingColor = "";
    private string _accentColor = "";
    private string _surfaceColor = "";
    private string _contrastColor = "";
    private string _headerBackgroundColor = "";
    private string _headerHeadingColor = "";
    private string _navColor = "";
    private string _navHoverColor = "";
    private string _navMobileBackgroundColor = "";
    private string _navDropdownBackgroundColor = "";
    private string _navDropdownColor = "";
    private string _navDropdownHoverColor = "";
    private string _lightBackgroundBackgroundColor = "";
    private string _lightBackgroundSurfaceColor = "";
    private string _darkBackgroundBackgroundColor = "";
    private string _darkBackgroundSurfaceColor = "";
    private string _darkBackgroundDefaultColor = "";
    private string _darkBackgroundHeadingColor = "";
    private string _darkBackgroundContrastColor = "";

    private string _exportFileName = "corporate-theme-colors.json";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (PageState.QueryString.ContainsKey("id"))
            {
                pageId = int.Parse(PageState.QueryString["id"]);
            }
            await LoadSettings();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Settings {Error}", ex.Message);
            AddModuleMessage("Error Loading Settings", MessageType.Error);
        }
    }

    private async Task LoadSettings()
    {
        // page settings
        var settings = await SettingService.GetPageSettingsAsync(pageId);
        _heroHTML = SettingService.GetSetting(settings, GetType().Namespace + ":Hero", "");
        _hero = (_heroHTML == "") ? "False" : "True";

        // site settings
        settings = PageState.Site.Settings;
        _login = SettingService.GetSetting(settings, GetType().Namespace + ":Login", "True");
        _search = SettingService.GetSetting(settings, GetType().Namespace + ":Search", "True");
        _navbuttontext = SettingService.GetSetting(settings, GetType().Namespace + ":NavButtonText", "");
        _navbuttonurl = SettingService.GetSetting(settings, GetType().Namespace + ":NavButtonUrl", "");
        if (!string.IsNullOrEmpty(_navbuttontext) && !string.IsNullOrEmpty(_navbuttonurl))
        {
            _navbutton = "True";
        }
        _footerHTML = SettingService.GetSetting(settings, GetType().Namespace + ":Footer", "");
        _footer = (_footerHTML == "") ? "False" : "True";

        // colors
        _backgroundColor = GetSetting(settings, GetType().Namespace + ":root:--background-color", backgroundColor);
        _defaultColor = GetSetting(settings, GetType().Namespace + ":root:--default-color", defaultColor);
        _headingColor = GetSetting(settings, GetType().Namespace + ":root:--heading-color", headingColor);
        _accentColor = GetSetting(settings, GetType().Namespace + ":root:--accent-color", accentColor);
        _surfaceColor = GetSetting(settings, GetType().Namespace + ":root:--surface-color", surfaceColor);
        _contrastColor = GetSetting(settings, GetType().Namespace + ":root:--contrast-color", contrastColor);
        _headerBackgroundColor = GetSetting(settings, GetType().Namespace + ":.header:--background-color", headerBackgroundColor);
        _headerHeadingColor = GetSetting(settings, GetType().Namespace + ":.header:--heading-color", headerHeadingColor);
        _navColor = GetSetting(settings, GetType().Namespace + ":root:--nav-color", navColor);
        _navHoverColor = GetSetting(settings, GetType().Namespace + ":root:--nav-hover-color", navHoverColor);
        _navMobileBackgroundColor = GetSetting(settings, GetType().Namespace + ":root:--nav-mobile-background-color", navMobileBackgroundColor);
        _navDropdownBackgroundColor = GetSetting(settings, GetType().Namespace + ":root:--nav-dropdown-background-color", navDropdownBackgroundColor);
        _navDropdownColor = GetSetting(settings, GetType().Namespace + ":root:--nav-dropdown-color", navDropdownColor);
        _navDropdownHoverColor = GetSetting(settings, GetType().Namespace + ":root:--nav-dropdown-hover-color", navDropdownHoverColor);
        _lightBackgroundBackgroundColor = GetSetting(settings, GetType().Namespace + ":.light-background:--background-color", lightBackgroundBackgroundColor);
        _lightBackgroundSurfaceColor = GetSetting(settings, GetType().Namespace + ":.light-background:--surface-color", lightBackgroundSurfaceColor);
        _darkBackgroundBackgroundColor = GetSetting(settings, GetType().Namespace + ":.dark-background:--background-color", darkBackgroundBackgroundColor);
        _darkBackgroundSurfaceColor = GetSetting(settings, GetType().Namespace + ":.dark-background:--surface-color", darkBackgroundSurfaceColor);
        _darkBackgroundDefaultColor = GetSetting(settings, GetType().Namespace + ":.dark-background:--default-color", darkBackgroundDefaultColor);
        _darkBackgroundHeadingColor = GetSetting(settings, GetType().Namespace + ":.dark-background:--heading-color", darkBackgroundHeadingColor);
        _darkBackgroundContrastColor = GetSetting(settings, GetType().Namespace + ":.dark-background:--contrast-color", darkBackgroundContrastColor);
    }

    private void HeroChanged(ChangeEventArgs eventArgs)
    {
        _hero = (string)eventArgs.Value;
        if (bool.Parse(_hero))
        {
            if (_heroHTML == "")
            {
                _heroHTML = Localizer["Hero"];
            }
        }
        else
        {
            _heroHTML = "";
        }
    }

    private void FooterChanged(ChangeEventArgs eventArgs)
    {
        _footer = (string)eventArgs.Value;
        if (bool.Parse(_footer))
        {
            if (_footerHTML == "")
            {
                _footerHTML = Localizer["Footer"];
            }
        }
        else
        {
            _footerHTML = "";
        }
    }

