    public async Task UpdateSettings()
    {
        try
        {
            // page settings
            var settings = await SettingService.GetPageSettingsAsync(pageId);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":Hero", _heroHTML);
            await SettingService.UpdatePageSettingsAsync(settings, pageId);

            // site settings
            settings = await SettingService.GetSiteSettingsAsync(PageState.Site.SiteId);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":Login", _login);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":Search", _search);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":NavButtonText", _navbuttontext);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":NavButtonUrl", _navbuttonurl);
            settings = SettingService.SetSetting(settings, GetType().Namespace + ":Footer", _footerHTML);

            // colors
            settings = SetSetting(settings, GetType().Namespace + ":root:--background-color", _backgroundColor, backgroundColor);
            settings = SetSetting(settings, GetType().Namespace + ":root:--default-color", _defaultColor, defaultColor);
            settings = SetSetting(settings, GetType().Namespace + ":root:--heading-color", _headingColor, headingColor);
            settings = SetSetting(settings, GetType().Namespace + ":root:--accent-color", _accentColor, accentColor);
            settings = SetSetting(settings, GetType().Namespace + ":root:--surface-color", _surfaceColor, surfaceColor);
            settings = SetSetting(settings, GetType().Namespace + ":root:--contrast-color", _contrastColor, contrastColor);
            settings = SetSetting(settings, GetType().Namespace + ":.header:--background-color", _headerBackgroundColor, headerBackgroundColor);
            settings = SetSetting(settings, GetType().Namespace + ":.header:--heading-color", _headerHeadingColor, headerHeadingColor);
            settings = SetSetting(settings, GetType().Namespace + ":root:--nav-color", _navColor, navColor);
            settings = SetSetting(settings, GetType().Namespace + ":root:--nav-hover-color", _navHoverColor, navHoverColor);
            settings = SetSetting(settings, GetType().Namespace + ":root:--nav-mobile-background-color", _navMobileBackgroundColor, navMobileBackgroundColor);
            settings = SetSetting(settings, GetType().Namespace + ":root:--nav-dropdown-background-color", _navDropdownBackgroundColor, navDropdownBackgroundColor);
            settings = SetSetting(settings, GetType().Namespace + ":root:--nav-dropdown-color", _navDropdownColor, navDropdownColor);
            settings = SetSetting(settings, GetType().Namespace + ":root:--nav-dropdown-hover-color", _navDropdownHoverColor, navDropdownHoverColor);
            settings = SetSetting(settings, GetType().Namespace + ":.light-background:--background-color", _lightBackgroundBackgroundColor, lightBackgroundBackgroundColor);
            settings = SetSetting(settings, GetType().Namespace + ":.light-background:--surface-color", _lightBackgroundSurfaceColor, lightBackgroundSurfaceColor);
            settings = SetSetting(settings, GetType().Namespace + ":.dark-background:--background-color", _darkBackgroundBackgroundColor, darkBackgroundBackgroundColor);
            settings = SetSetting(settings, GetType().Namespace + ":.dark-background:--surface-color", _darkBackgroundSurfaceColor, darkBackgroundSurfaceColor);
            settings = SetSetting(settings, GetType().Namespace + ":.dark-background:--default-color", _darkBackgroundDefaultColor, darkBackgroundDefaultColor);
            settings = SetSetting(settings, GetType().Namespace + ":.dark-background:--heading-color", _darkBackgroundHeadingColor, darkBackgroundHeadingColor);
            settings = SetSetting(settings, GetType().Namespace + ":.dark-background:--contrast-color", _darkBackgroundContrastColor, darkBackgroundContrastColor);

            await SettingService.UpdateSiteSettingsAsync(settings, PageState.Site.SiteId);

            if (UserSecurity.IsAuthorized(PageState.User, RoleNames.Admin))
            {
                await CorporateThemeService.UpdateStylesheetAsync(ModuleState.SiteId);
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Saving Settings {Error}", ex.Message);
            AddModuleMessage("Error Saving Settings", MessageType.Error);
        }
    }

    private string GetExportUrl()
    {
        var colors = new CorporateThemeColors
        {
            Version = 1,
            BackgroundColor = _backgroundColor,
            DefaultColor = _defaultColor,
            HeadingColor = _headingColor,
            AccentColor = _accentColor,
            SurfaceColor = _surfaceColor,
            ContrastColor = _contrastColor,
            HeaderBackgroundColor = _headerBackgroundColor,
            HeaderHeadingColor = _headerHeadingColor,
            NavColor = _navColor,
            NavHoverColor = _navHoverColor,
            NavMobileBackgroundColor = _navMobileBackgroundColor,
            NavDropdownBackgroundColor = _navDropdownBackgroundColor,
            NavDropdownColor = _navDropdownColor,
            NavDropdownHoverColor = _navDropdownHoverColor,
            LightBackgroundBackgroundColor = _lightBackgroundBackgroundColor,
            LightBackgroundSurfaceColor = _lightBackgroundSurfaceColor,
            DarkBackgroundBackgroundColor = _darkBackgroundBackgroundColor,
            DarkBackgroundSurfaceColor = _darkBackgroundSurfaceColor,
            DarkBackgroundDefaultColor = _darkBackgroundDefaultColor,
            DarkBackgroundHeadingColor = _darkBackgroundHeadingColor,
            DarkBackgroundContrastColor = _darkBackgroundContrastColor
        };

        var json = JsonSerializer.Serialize(colors, new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
            WriteIndented = true
        });

        return "data:application/json;charset=utf-8," + Uri.EscapeDataString(json);
    }

    private async Task ImportColorsAsync(InputFileChangeEventArgs eventArgs)
    {
        try
        {
            var file = eventArgs.File;
            using var stream = file.OpenReadStream(64 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var themeColors = JsonSerializer.Deserialize<CorporateThemeColors>(json, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });

            if (themeColors != null && themeColors.Version == 1)
            {
                _backgroundColor = themeColors.BackgroundColor;
                _defaultColor = themeColors.DefaultColor;
                _headingColor = themeColors.HeadingColor;
                _accentColor = themeColors.AccentColor;
                _surfaceColor = themeColors.SurfaceColor;
                _contrastColor = themeColors.ContrastColor;
                _headerBackgroundColor = themeColors.HeaderBackgroundColor;
                _headerHeadingColor = themeColors.HeaderHeadingColor;
                _navColor = themeColors.NavColor;
                _navHoverColor = themeColors.NavHoverColor;
                _navMobileBackgroundColor = themeColors.NavMobileBackgroundColor;
                _navDropdownBackgroundColor = themeColors.NavDropdownBackgroundColor;
                _navDropdownColor = themeColors.NavDropdownColor;
                _navDropdownHoverColor = themeColors.NavDropdownHoverColor;
                _lightBackgroundBackgroundColor = themeColors.LightBackgroundBackgroundColor;
                _lightBackgroundSurfaceColor = themeColors.LightBackgroundSurfaceColor;
                _darkBackgroundBackgroundColor = themeColors.DarkBackgroundBackgroundColor;
                _darkBackgroundSurfaceColor = themeColors.DarkBackgroundSurfaceColor;
                _darkBackgroundDefaultColor = themeColors.DarkBackgroundDefaultColor;
                _darkBackgroundHeadingColor = themeColors.DarkBackgroundHeadingColor;
                _darkBackgroundContrastColor = themeColors.DarkBackgroundContrastColor;

                AddModuleMessage("Theme Colors Imported Successfully. You Will Need To Select The Save Button To Apply The Changes.", MessageType.Success);
            }
            else
            {
                AddModuleMessage("Error Importing Theme Colors", MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Importing Theme Colors {Error}", ex.Message);
            AddModuleMessage("Error Importing Theme Colors", MessageType.Error);
        }
    }

    private string GetSetting(Dictionary<string, string> settings, string settingName, string defaultValue)
    {
        var value = SettingService.GetSetting(settings, settingName, "");
        return (string.IsNullOrEmpty(value) ? defaultValue : value);
    }
    private Dictionary<string, string> SetSetting(Dictionary<string, string> settings, string settingName, string settingValue, string defaultValue)
    {
        return SettingService.SetSetting(settings, settingName, (settingValue == defaultValue) ? "" : settingValue);
    }

