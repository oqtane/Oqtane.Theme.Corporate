        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="light-background-surface-color" HelpText="Optionally specify a surface color for light sections">Surface Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="light-background-surface-color" class="form-control" placeholder="#000000" @bind="@_lightBackgroundSurfaceColor" />
