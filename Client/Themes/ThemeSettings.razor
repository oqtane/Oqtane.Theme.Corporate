@namespace Oqtane.Theme.Corporate
@using Oqtane.Theme.Corporate.Services
@inherits ModuleBase
@implements Oqtane.Interfaces.ISettingsControl
@inject ISettingService SettingService
@inject ICorporateThemeService CorporateThemeService
@inject IStringLocalizer<Default> Localizer
@attribute [OqtaneIgnore]

<div class="container">
    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="login" HelpText="Specify if a Login option should be displayed. Note that this option does not prevent the login page from being accessible via a direct url.">Show Login?</Label>
        <div class="col-sm-9">
            <select id="login" class="form-select" @bind="@_login">
                <option value="True">Yes</option>
                <option value="False">No</option>
            </select>
        </div>
    </div>
    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="search" HelpText="Specify if a search icon should be displayed">Show Search?</Label>
        <div class="col-sm-9">
            <select id="search" class="form-select" @bind="@_search">
                <option value="True">Yes</option>
                <option value="False">No</option>
            </select>
        </div>
    </div>
    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="_navbutton" HelpText="Specify if you wish to include a call-to-action button in the navigation for this site">Navigation Button?</Label>
        <div class="col-sm-9">
            <select id="navbutton" class="form-select" @bind="@_navbutton">
                <option value="True">Yes</option>
                <option value="False">No</option>
            </select>
            @if (_navbutton == "True")
            {
                <input id="navbuttoncode" class="form-control" placeholder="Button Text" @bind="@_navbuttontext" />
                <input id="navbuttonurl" class="form-control" placeholder="Button Url" @bind="@_navbuttonurl" />
            }
        </div>
    </div>
</div>
<Section Name="Hero" Heading="Hero Banner" ResourceKey="Hero" Expanded="False">
    <div class="container">
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="heroHTML" HelpText="Specify if you wish to include a hero banner for this page">Include Banner?</Label>
            <div class="col-sm-9">
                <select id="heroHTML" class="form-select" value="@_hero" @onchange="(e => HeroChanged(e))">
                    <option value="True">Yes</option>
                    <option value="False">No</option>
                </select>
                @if (_hero == "True")
                {
                    <textarea id="_heroHTML" class="form-control" @bind="@_heroHTML" rows="5"></textarea>
                }
            </div>
        </div>
    </div>
</Section>
<Section Name="Footer" Heading="Footer Section" ResourceKey="Footer" Expanded="False">
    <div class="container">
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="_footerHTML" HelpText="Specify if you wish to include a footer section for this site">Include Footer?</Label>
            <div class="col-sm-9">
                <select id="footerHTML" class="form-select" value="@_footer" @onchange="(e => FooterChanged(e))">
                    <option value="True">Yes</option>
                    <option value="False">No</option>
                </select>
                @if (_footer == "True")
                {
                    <textarea id="footerHTML" class="form-control" @bind="@_footerHTML" rows="5"></textarea>
                }
            </div>
        </div>
    </div>
</Section>
<Section Name="MainColors" Heading="Main Colors" ResourceKey="Colors" Expanded="False">
    <div class="container">
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="background-color" HelpText="Optionally specify a background color for the entire website, including individual sections">Background Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="background-color" class="form-control" @bind="@_backgroundColor" />
                    <button type="button" class="btn btn-secondary" @onclick="@StateHasChanged">Show</button>
                    <div style="background-color: @_backgroundColor; width: 50px">&nbsp;</div>
                </div>
            </div>
        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="default-color" HelpText="Optionally specify a default color used for the majority of the text content across the entire website">Default Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="default-color" class="form-control" placeholder="#000000" @bind="@_defaultColor" />
                    <button type="button" class="btn btn-secondary" @onclick="@StateHasChanged">Show</button>
                    <div style="background-color: @_defaultColor; width: 50px">&nbsp;</div>
                </div>
            </div>
        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="heading-color" HelpText="Optionally specify a color for headings, subheadings and title throughout the website">Heading Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="heading-color" class="form-control" placeholder="#000000" @bind="@_headingColor" />
                    <button type="button" class="btn btn-secondary" @onclick="@StateHasChanged">Show</button>
                    <div style="background-color: @_headingColor; width: 50px">&nbsp;</div>
                </div>
            </div>
        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="accent-color" HelpText="Optionally specify an color that represents your brand on the website. It's used for buttons, links, and other elements that need to stand out">Accent Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="accent-color" class="form-control" placeholder="#000000" @bind="@_accentColor" />
                    <button type="button" class="btn btn-secondary" @onclick="@StateHasChanged">Show</button>
                    <div style="background-color: @_accentColor; width: 50px">&nbsp;</div>
                </div>
            </div>
        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="surface-color" HelpText="Optionally specify a surface color is used as a background of boxed elements within sections, such as cards, icon boxes, or other elements that require a visual separation from the global background">Surface Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="surface-color" class="form-control" placeholder="#000000" @bind="@_surfaceColor" />
                    <button type="button" class="btn btn-secondary" @onclick="@StateHasChanged">Show</button>
                    <div style="background-color: @_surfaceColor; width: 50px">&nbsp;</div>
                </div>
            </div>
        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="contrast-color" HelpText="Optionally specify a contrast color for text, ensuring readability against backgrounds of accent, heading, or default colors">Contrast Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="contrast-color" class="form-control" placeholder="#000000" @bind="@_contrastColor" />
                    <button type="button" class="btn btn-secondary" @onclick="@StateHasChanged">Show</button>
                    <div style="background-color: @_contrastColor; width: 50px">&nbsp;</div>
                </div>
            </div>
        </div>
    </div>
</Section>
<Section Name="HeaderColors" Heading="Header Colors" ResourceKey="HeaderColors" Expanded="False">
    <div class="container">
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="header-background-color" HelpText="Optionally specify a color for the site header">Background Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="header-background-color" class="form-control" placeholder="#000000" @bind="@_headerBackgroundColor" />
                    <button type="button" class="btn btn-secondary" @onclick="@StateHasChanged">Show</button>
                    <div style="background-color: @_headerBackgroundColor; width: 50px">&nbsp;</div>
                </div>
            </div>
        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="header-heading-color" HelpText="Optionally specify a color for the header heading color">Heading Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="header-heading-color" class="form-control" placeholder="#000000" @bind="@_headerHeadingColor" />
                    <button type="button" class="btn btn-secondary" @onclick="@StateHasChanged">Show</button>
                    <div style="background-color: @_headerHeadingColor; width: 50px">&nbsp;</div>
                </div>
            </div>
        </div>
    </div>
</Section>
<Section Name="NavigationColors" Heading="Navigation Colors" ResourceKey="NavigationColors" Expanded="False">
    <div class="container">
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="nav-color" HelpText="Optionally specify a default color of the main navmenu links">Link Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="nav-color" class="form-control" placeholder="#000000" @bind="@_navColor" />
                    <button type="button" class="btn btn-secondary" @onclick="@StateHasChanged">Show</button>
                    <div style="background-color: @_navColor; width: 50px">&nbsp;</div>
                </div>
            </div>
        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="nav-hover-color" HelpText="Optionally specify a color for the main navmenu links when they are hovered over or active">Hover Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="nav-hover-color" class="form-control" placeholder="#000000" @bind="@_navHoverColor" />
                    <button type="button" class="btn btn-secondary" @onclick="@StateHasChanged">Show</button>
                    <div style="background-color: @_navHoverColor; width: 50px">&nbsp;</div>
                </div>
            </div>
        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="nav-mobile-background-color" HelpText="Optionally specify a background color for mobile navigation menu">Mobile Background Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="nav-mobile-background-color" class="form-control" placeholder="#000000" @bind="@_navMobileBackgroundColor" />
                    <button type="button" class="btn btn-secondary" @onclick="@StateHasChanged">Show</button>
                    <div style="background-color: @_navMobileBackgroundColor; width: 50px">&nbsp;</div>
                </div>
            </div>
        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="nav-dropdown-background-color" HelpText="Optionally specify a background color for dropdown items that appear when hovering over primary navigation items">Dropdown Background Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="nav-dropdown-background-color" class="form-control" placeholder="#000000" @bind="@_navDropdownBackgroundColor" />
                    <button type="button" class="btn btn-secondary" @onclick="@StateHasChanged">Show</button>
                    <div style="background-color: @_navDropdownBackgroundColor; width: 50px">&nbsp;</div>
                </div>
            </div>
        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="nav-dropdown-color" HelpText="Optionally specify a color for navigation links of the dropdown items in the navigation menu">Dropdown Link Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="nav-dropdown-color" class="form-control" placeholder="#000000" @bind="@_navDropdownColor" />
                    <button type="button" class="btn btn-secondary" @onclick="@StateHasChanged">Show</button>
                    <div style="background-color: @_navDropdownColor; width: 50px">&nbsp;</div>
                </div>
            </div>
        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="nav-dropdown-hover-color" HelpText="Optionally specify a color is applied to dropdown navigation links when they are hovered over">Dropdown Hover Color:</Label>
            <div class="col-sm-9">
                <div class="input-group">
                    <input id="nav-dropdown-hover-color" class="form-control" placeholder="#000000" @bind="@_navDropdownHoverColor" />
                    <button type="button" class="btn btn-secondary" @onclick="@StateHasChanged">Show</button>
                    <div style="background-color: @_navDropdownHoverColor; width: 50px">&nbsp;</div>
                </div>
            </div>
        </div>
    </div>
</Section>
